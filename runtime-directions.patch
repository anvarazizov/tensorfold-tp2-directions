+//! Strict experimental request parser. The serving profile pins the one loaded set.
+const std = @import("std");
+const json = @import("json");
+const errors = @import("errors.zig");
+const Cx = errors.Cx;
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return std.mem.span(std.c.getenv(name) orelse return null);
+}
+
+pub fn parse(cx: *Cx, value: json.Value) errors.Refused![44]u8 {
+    if (value != .object) return cx.refuse("ablation must be an object");
+    if (!std.mem.eql(u8, env("TF_RUNTIME_DIRECTIONS_EXPERIMENTAL") orelse "", "1") or env("TF_RUNTIME_DIRECTIONS_BUNDLE") == null)
+        return cx.refuse("runtime directions are unavailable on this profile");
+    for (value.object.keys()) |key| {
+        var known = false;
+        for ([_][]const u8{ "projection_mode", "enabled", "strength", "direction_set", "layers" }) |name|
+            known = known or std.mem.eql(u8, key, name);
+        if (!known) return cx.refuse("unknown ablation field");
+    }
+    if (value.get("projection_mode")) |mode|
+        if (mode != .string or !std.mem.eql(u8, mode.string, "ablated")) return cx.refuse("only ablated projection_mode is supported");
+    const enabled = value.get("enabled") orelse json.Value{ .bool = false };
+    if (enabled != .bool) return cx.refuse("enabled must be boolean");
+    const strength = value.get("strength") orelse json.Value{ .float = 0 };
+    if (strength != .int and strength != .float) return cx.refuse("strength must be a number");
+    const alpha64 = strength.float64() orelse return cx.refuse("invalid strength");
+    if (!std.math.isFinite(alpha64) or alpha64 < 0 or alpha64 > 1 or (!enabled.bool and alpha64 != 0))
+        return cx.refuse("strength must be in [0,1], and zero when disabled");
+    const set = value.get("direction_set") orelse {
+        if (enabled.bool or value.has("layers")) return cx.refuse("direction_set is required");
+        return @splat(0);
+    };
+    if (set != .string or !std.mem.eql(u8, set.string, env("TF_RUNTIME_DIRECTIONS_SET") orelse ""))
+        return cx.refuse("unknown direction_set");
+    const allowed = std.fmt.parseInt(u64, env("TF_RUNTIME_DIRECTIONS_MASK") orelse "", 10) catch return cx.refuse("missing artifact layer mask");
+    var mask = allowed;
+    if (value.get("layers")) |layers| {
+        if (layers != .array or layers.array.len == 0 or layers.array.len > 40) return cx.refuse("expected 1-40 layers");
+        mask = 0;
+        for (layers.array) |layer| {
+            if (layer != .int) return cx.refuse("layers must be integers");
+            const n = layer.int64() orelse return cx.refuse("invalid layer");
+            if (n < 0 or n >= 40) return cx.refuse("layer outside 0-39");
+            const bit = @as(u64, 1) << @intCast(n);
+            if (mask & bit != 0 or allowed & bit == 0) return cx.refuse("duplicate or unavailable layer");
+            mask |= bit;
+        }
+    }
+    var result: [44]u8 = @splat(0);
+    const alpha: f32 = @floatCast(alpha64);
+    std.mem.writeInt(u32, result[0..4], @bitCast(alpha), .little);
+    std.mem.writeInt(u64, result[4..12], mask, .little);
+    const hash = env("TF_RUNTIME_DIRECTIONS_SHA256") orelse return cx.refuse("missing artifact SHA256");
+    if (hash.len != 64) return cx.refuse("invalid artifact SHA256");
+    _ = std.fmt.hexToBytes(result[12..44], hash) catch return cx.refuse("invalid artifact SHA256");
+    return result;
+}
+
+pub fn salt(a: std.mem.Allocator, packet: [44]u8, user: ?[]const u8) !?[]const u8 {
+    if (env("TF_RUNTIME_DIRECTIONS_BUNDLE") == null) return user;
+    const weights = env("TF_RUNTIME_DIRECTIONS_WEIGHTS_SHA256") orelse return error.MissingWeightIdentity;
+    if (weights.len != 64) return error.MissingWeightIdentity;
+    // Length-prefixed user salt prevents concatenation collisions; packet includes bundle, alpha and mask.
+    const user_salt: []const u8 = user orelse "";
+    return try std.fmt.allocPrint(a, "runtime-directions:wo_b-pre-gather-v1:e100ee8b:{s}:{s}:{d}:{s}", .{ weights, std.fmt.bytesToHex(packet, .lower), user_salt.len, user_salt });
+}
+
+extern "c" fn setenv([*:0]const u8, [*:0]const u8, c_int) c_int;
+extern "c" fn unsetenv([*:0]const u8) c_int;
+
+test "runtime directions strict schema, canonical packet, cache isolation" {
+    const vars = .{
+        .{ "TF_RUNTIME_DIRECTIONS_BUNDLE", "/fixture-only" },
+        .{ "TF_RUNTIME_DIRECTIONS_EXPERIMENTAL", "1" },
+        .{ "TF_RUNTIME_DIRECTIONS_SET", "fixture" },
+        .{ "TF_RUNTIME_DIRECTIONS_MASK", "12" },
+        .{ "TF_RUNTIME_DIRECTIONS_SHA256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
+        .{ "TF_RUNTIME_DIRECTIONS_WEIGHTS_SHA256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" },
+    };
+    inline for (vars) |pair| try std.testing.expectEqual(@as(c_int, 0), setenv(pair[0], pair[1], 1));
+    defer inline for (vars) |pair| {
+        _ = unsetenv(pair[0]);
+    };
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    const valid = (try json.parse(cx.a, "{\"direction_set\":\"fixture\",\"enabled\":true,\"strength\":0.5,\"layers\":[3,2]}")).ok;
+    const packet = try parse(&cx, valid);
+    try std.testing.expectEqual(@as(f32, 0.5), @as(f32, @bitCast(std.mem.readInt(u32, packet[0..4], .little))));
+    try std.testing.expectEqual(@as(u64, 12), std.mem.readInt(u64, packet[4..12], .little));
+    const first = (try salt(cx.a, packet, "user")).?;
+    try std.testing.expectEqualStrings(first, (try salt(cx.a, packet, "user")).?);
+    try std.testing.expect(!std.mem.eql(u8, first, (try salt(cx.a, @splat(0), "user")).?));
+    try std.testing.expect(!std.mem.eql(u8, first, (try salt(cx.a, packet, "other")).?));
+    for ([_][]const u8{
+        "null",                            "[]",                                               "{\"extra\":1}",                                   "{\"enabled\":1}",                                   "{\"strength\":true}",
+        "{\"strength\":-1}",               "{\"strength\":2}",                                 "{\"strength\":0.5}",                              "{\"enabled\":true}",                                "{\"projection_mode\":\"original_projections\"}",
+        "{\"direction_set\":\"missing\"}", "{\"direction_set\":\"fixture\",\"layers\":[2,2]}", "{\"direction_set\":\"fixture\",\"layers\":[40]}", "{\"direction_set\":\"fixture\",\"layers\":[true]}", "{\"direction_set\":\"fixture\",\"layers\":[]}",
+    }) |text| try std.testing.expectError(error.Refused, parse(&cx, (try json.parse(cx.a, text)).ok));
+    _ = unsetenv("TF_RUNTIME_DIRECTIONS_EXPERIMENTAL");
+    try std.testing.expectError(error.Refused, parse(&cx, valid));
+}
