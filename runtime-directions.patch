+//! Experimental C1 TP2 directions. Loaded only by an explicitly isolated profile.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Packet = [44]u8; // alpha LE f32, mask LE u64, payload SHA256
+pub const zero: Packet = @splat(0);
+const width = 5120;
+const payload_bytes = 40 * width * 4;
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return std.mem.span(std.c.getenv(name) orelse return null);
+}
+
+pub fn configured() bool {
+    return env("TF_RUNTIME_DIRECTIONS_BUNDLE") != null;
+}
+
+pub const Runtime = struct {
+    vectors: cuda.DeviceBuffer,
+    module: cuda.Module,
+    kernel: cuda.Function,
+    sha: [32]u8,
+    identity: [32]u8,
+    mask: u64,
+    active: Packet = zero,
+
+    pub fn open(a: std.mem.Allocator, io: std.Io, d: *const cuda.Driver) !?*Runtime {
+        const path = env("TF_RUNTIME_DIRECTIONS_BUNDLE") orelse return null;
+        if (!std.mem.eql(u8, env("TF_RUNTIME_DIRECTIONS_EXPERIMENTAL") orelse "", "1"))
+            return error.DirectionsNotQualified;
+        // Zig readFileAlloc rejects a length equal to the limit; validate exact size below.
+        const raw = try std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(payload_bytes + 17));
+        defer a.free(raw);
+        if (raw.len != payload_bytes + 16 or !std.mem.eql(u8, raw[0..8], "TFDIR001")) return error.BadDirections;
+        const mask = std.mem.readInt(u64, raw[8..16], .little);
+        if (mask == 0 or mask >> 40 != 0) return error.BadDirections;
+        var hash: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(raw, &hash, .{});
+        var expected: [32]u8 = undefined;
+        const hex = env("TF_RUNTIME_DIRECTIONS_SHA256") orelse return error.BadDirections;
+        if (hex.len != 64) return error.BadDirections;
+        _ = try std.fmt.hexToBytes(&expected, hex);
+        if (!std.mem.eql(u8, &hash, &expected)) return error.DirectionsHashMismatch;
+        const allowed = try std.fmt.parseInt(u64, env("TF_RUNTIME_DIRECTIONS_MASK") orelse return error.BadDirections, 10);
+        if (allowed != mask) return error.BadDirections;
+        for (0..40) |layer| {
+            var norm: f64 = 0;
+            for (0..width) |j| {
+                const offset = 16 + (layer * width + j) * 4;
+                const v: f32 = @bitCast(std.mem.readInt(u32, raw[offset..][0..4], .little));
+                if (!std.math.isFinite(v)) return error.BadDirections;
+                norm += @as(f64, v) * v;
+            }
+            const present = mask & (@as(u64, 1) << @intCast(layer)) != 0;
+            if (if (present) @abs(norm - 1) > 1e-5 else norm != 0) return error.BadDirections;
+        }
+        const kernel_path = env("TF_RUNTIME_DIRECTIONS_KERNEL") orelse return error.NoDirectionKernel;
+        const image = try std.Io.Dir.cwd().readFileAlloc(io, kernel_path, a, .limited(4 << 20));
+        defer a.free(image);
+        const kernel_hex = env("TF_RUNTIME_DIRECTIONS_KERNEL_SHA256") orelse return error.NoDirectionKernel;
+        if (kernel_hex.len != 64) return error.NoDirectionKernel;
+        var kernel_expected: [32]u8 = undefined;
+        _ = try std.fmt.hexToBytes(&kernel_expected, kernel_hex);
+        var kernel_actual: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(image, &kernel_actual, .{});
+        if (!std.mem.eql(u8, &kernel_expected, &kernel_actual)) return error.DirectionKernelHashMismatch;
+        const weight_hex = env("TF_RUNTIME_DIRECTIONS_WEIGHTS_SHA256") orelse return error.MissingWeightIdentity;
+        if (weight_hex.len != 64) return error.MissingWeightIdentity;
+        var weight_sha: [32]u8 = undefined;
+        _ = try std.fmt.hexToBytes(&weight_sha, weight_hex);
+        var identity_input: [96]u8 = undefined;
+        @memcpy(identity_input[0..32], &hash);
+        @memcpy(identity_input[32..64], &kernel_actual);
+        @memcpy(identity_input[64..96], &weight_sha);
+        var identity: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(&identity_input, &identity, .{});
+        var mod = try cuda.Module.load(d, image);
+        errdefer mod.unload();
+        const kernel = try mod.function("tf_runtime_direction_f32");
+        var vectors = try cuda.DeviceBuffer.fromHost(d, raw[16..]);
+        errdefer vectors.free();
+        const result = try a.create(Runtime);
+        result.* = .{ .vectors = vectors, .module = mod, .kernel = kernel, .sha = hash, .identity = identity, .mask = mask };
+        return result;
+    }
+
+    pub fn close(r: *Runtime) void {
+        r.vectors.free();
+        r.module.unload();
+    }
+
+    pub fn select(r: *Runtime, packet: Packet) !void {
+        if (std.mem.eql(u8, &packet, &zero)) {
+            r.active = zero;
+            return;
+        }
+        const alpha: f32 = @bitCast(std.mem.readInt(u32, packet[0..4], .little));
+        const mask = std.mem.readInt(u64, packet[4..12], .little);
+        if (!std.math.isFinite(alpha) or alpha < 0 or alpha > 1 or mask == 0 or mask & ~r.mask != 0)
+            return error.BadDirectionsConfig;
+        if (!std.mem.eql(u8, packet[12..44], &r.sha)) return error.DirectionsHashMismatch;
+        r.active = packet;
+    }
+
+    pub fn apply(r: *const Runtime, stream: cuda.Stream, layer: usize, y: u64, rows: usize) !void {
+        if (layer >= 40) return error.BadDirectionLayer;
+        const alpha: f32 = @bitCast(std.mem.readInt(u32, r.active[0..4], .little));
+        const mask = std.mem.readInt(u64, r.active[4..12], .little);
+        // EXACT baseline bypass: no kernel, synchronization, or arithmetic.
+        if (alpha == 0 or mask & (@as(u64, 1) << @intCast(layer)) == 0 or rows == 0) return;
+        var args: cuda.Args = .{};
+        args.add(y);
+        args.add(r.vectors.ptr + layer * width * 4);
+        args.add(alpha);
+        args.add(@as(u32, @intCast(rows)));
+        try cuda.launch.launch(r.kernel, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, stream, &args);
+    }
+};
+
+test "runtime directions peer packet validation and zero reset" {
+    var r: Runtime = undefined; // no CUDA driver/context is created by this CPU test
+    r.sha = @splat(0xaa);
+    r.mask = 12;
+    r.active = zero;
+    var packet: Packet = zero;
+    std.mem.writeInt(u32, packet[0..4], @bitCast(@as(f32, 0.5)), .little);
+    std.mem.writeInt(u64, packet[4..12], 4, .little);
+    @memcpy(packet[12..44], &r.sha);
+    try r.select(packet);
+    try std.testing.expectEqual(packet, r.active);
+    var bad = packet;
+    bad[12] ^= 1;
+    try std.testing.expectError(error.DirectionsHashMismatch, r.select(bad));
+    try std.testing.expectEqual(packet, r.active);
+    bad = packet;
+    std.mem.writeInt(u64, bad[4..12], 1, .little);
+    try std.testing.expectError(error.BadDirectionsConfig, r.select(bad));
+    bad = packet;
+    std.mem.writeInt(u32, bad[0..4], 0x7fc00000, .little);
+    try std.testing.expectError(error.BadDirectionsConfig, r.select(bad));
+    try r.select(zero);
+    try std.testing.expectEqual(zero, r.active);
+}
