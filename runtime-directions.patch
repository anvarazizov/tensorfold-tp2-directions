+// One block per full-width rank-local wo_b output, before the existing TP gather.
+// TP2 splits inputs; each partial spans all 5120 output coordinates.
+// Launch only for nonzero alpha. No residual/hyperconnection tensor is touched.
+#include <cuda_runtime.h>
+extern "C" __global__ void tf_runtime_direction_f32(
+    float* y, const float* r, float alpha, unsigned int rows) {
+    const unsigned int row = blockIdx.x;
+    if (row >= rows || alpha == 0.0f) return;
+    __shared__ float partial[256];
+    const unsigned int t = threadIdx.x;
+    float dot = 0.0f;
+    for (unsigned int j = t; j < 5120; j += 256)
+        dot = __fadd_rn(dot, __fmul_rn(y[row * 5120 + j], r[j]));
+    partial[t] = dot;
+    __syncthreads();
+    for (unsigned int stride = 128; stride; stride >>= 1) {
+        if (t < stride) partial[t] = __fadd_rn(partial[t], partial[t + stride]);
+        __syncthreads();
+    }
+    const float scale = __fmul_rn(alpha, partial[0]);
+    for (unsigned int j = t; j < 5120; j += 256)
+        y[row * 5120 + j] = __fsub_rn(y[row * 5120 + j], __fmul_rn(scale, r[j]));
+}
